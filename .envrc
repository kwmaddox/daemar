# direnv: decrypt the factory's secrets into the environment on cd.
# The encrypted file is tracked; the age key never leaves ~/.config.
# DAEMAR_HOME roots the tower's state (ledgers, airframes, secrets) so
# daemar works from anywhere; MCP-spawned processes skip direnv entirely
# and fetch their own key via the in-process vault.
export DAEMAR_HOME="$PWD"
export SOPS_AGE_KEY_FILE="$HOME/.config/sops/age/keys.txt"

if [ -f secrets/daemar.enc.env ] && [ -f "$SOPS_AGE_KEY_FILE" ] && command -v sops >/dev/null; then
  set -a
  eval "$(sops -d secrets/daemar.enc.env)"
  set +a
fi
