    queue_row_for(&doc, &id);
}

#[then("no Card identity or stream is shown")]
fn no_identity_or_stream(w: &mut CardWorld) {
    let doc = w.last_doc();
    for landmark in [
        role::CARD_IDENTITY,
        role::STREAM,
        role::STREAM_ROW,
        role::INSPECTOR,
    ] {
        assert!(!doc.has_role(landmark), "data-role={landmark} is rendered");
    }
}

