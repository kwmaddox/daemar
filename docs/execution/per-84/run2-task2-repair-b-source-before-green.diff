+        let cases = [
+            (
+                "exact",
+                vec![(1, vec![1], true), (2, vec![2], true), (3, vec![3], true)].into_iter().map(|(version, checksum, success)| AppliedMigration { version, checksum, success }).collect(),
+                None,
+            ),
+            (
+                "empty",
+                Vec::new().into_iter().collect(),
+                Some(SchemaIncompatibility::Uninitialized),
+            ),
+            (
+                "behind",
+                vec![(1, vec![1], true)].into_iter().map(|(version, checksum, success)| AppliedMigration { version, checksum, success }).collect(),
+                Some(SchemaIncompatibility::Behind {
+                    applied: 1,
+                    required: 3,
+                    next_required: MigrationVersion::new(2),
+                }),
+            ),
+            (
+                "ahead",
+                vec![
+                    (1, vec![1], true),
+                    (2, vec![2], true),
+                    (3, vec![3], true),
+                    (4, vec![4], true),
+                ].into_iter().map(|(version, checksum, success)| AppliedMigration { version, checksum, success }).collect(),
+                Some(SchemaIncompatibility::Ahead {
+                    unknown_version: MigrationVersion::new(4),
+                }),
+            ),
+            (
+                "diverged",
+                vec![(1, vec![1], true), (9, vec![2], true)].into_iter().map(|(version, checksum, success)| AppliedMigration { version, checksum, success }).collect(),
+                Some(SchemaIncompatibility::Diverged {
+                    expected: MigrationVersion::new(2),
+                    found: MigrationVersion::new(9),
